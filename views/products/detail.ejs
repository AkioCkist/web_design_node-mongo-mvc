<!DOCTYPE html>
<html lang="vi">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/styles.css"></head>
<body><main class="container narrow">
  <a href="/products">← Danh sách sản phẩm</a>
  <article class="detail">
    <p class="eyebrow">CHI TIẾT SẢN PHẨM</p>
    <h1><%= product.name %></h1>
    <p class="price"><%= product.price.toLocaleString('vi-VN') %> đ</p>
    <p><strong>Danh mục:</strong> <%= product.categoryId ? product.categoryId.name : 'Không có' %></p>
    <p><strong>Tồn kho:</strong> <%= product.stock %></p>
    <p><strong>Mô tả:</strong> <%= product.description || 'Chưa có mô tả.' %></p>
    <a class="button secondary" href="/products/edit/<%= product._id %>">Sửa sản phẩm</a>
  </article>
</main></body>
</html>
